@page "/cambiar-password"
@layout MainLayout
@attribute [Authorize]
@using CementoTrazabilidad.Shared.DTOs
@inject IClientAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Cambiar Contraseña - CementoTrazabilidad</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="fas fa-key me-2"></i>Cambiar Contraseña</h1>
            <p class="text-muted">Actualice su contraseña de acceso al sistema</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-lock me-2"></i>Nueva Contraseña</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@model" OnValidSubmit="CambiarPasswordHandler">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-key me-1"></i>Contraseña Actual
                            </label>
                            <input type="password"
                                   class="form-control"
                                   @bind="model.PasswordActual"
                                   placeholder="Ingrese su contraseña actual"
                                   autocomplete="current-password" />
                            <ValidationMessage For="@(() => model.PasswordActual)" />
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-lock me-1"></i>Nueva Contraseña
                            </label>
                            <input type="password"
                                   class="form-control"
                                   @bind="model.PasswordNueva"
                                   placeholder="Ingrese su nueva contraseña"
                                   autocomplete="new-password" />
                            <ValidationMessage For="@(() => model.PasswordNueva)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-lock me-1"></i>Confirmar Nueva Contraseña
                            </label>
                            <input type="password"
                                   class="form-control"
                                   @bind="model.ConfirmarPassword"
                                   placeholder="Repita la nueva contraseña"
                                   autocomplete="new-password" />
                            <ValidationMessage For="@(() => model.ConfirmarPassword)" />
                        </div>

                        <!-- Requisitos -->
                        <div class="alert alert-info py-2 mb-3">
                            <small>
                                <strong><i class="fas fa-info-circle me-1"></i>Requisitos:</strong>
                                <ul class="mb-0 mt-2 ps-3">
                                    <li>Mínimo 8 caracteres</li>
                                    <li>Al menos una mayúscula</li>
                                    <li>Al menos una minúscula</li>
                                    <li>Al menos un número</li>
                                </ul>
                            </small>
                        </div>

                        <!-- Mensajes -->
                        @if (!string.IsNullOrEmpty(mensajeExito))
                        {
                            <div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>@mensajeExito
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>@mensajeError
                            </div>
                        }

                        <!-- Botones -->
                        <div class="d-flex justify-content-between">
                            <button type="button"
                                    class="btn btn-secondary"
                                    @onclick="LimpiarFormulario"
                                    disabled="@guardando">
                                <i class="fas fa-eraser me-1"></i>Limpiar
                            </button>

                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <i class="fas fa-save me-1"></i>
                                    <span>Cambiar Contraseña</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Nota de privacidad -->
            <div class="card shadow mt-3 border-info">
                <div class="card-body">
                    <h6 class="text-info">
                        <i class="fas fa-shield-alt me-2"></i>Política de Privacidad
                    </h6>
                    <small class="text-muted">
                        Su contraseña es personal e intransferible. Se almacena de forma segura con cifrado.
                        Nadie, ni siquiera el administrador, puede ver su contraseña. Si la olvida, solicite
                        al administrador que le asigne una temporal.
                    </small>
                </div>
            </div>
        </div>

        <!-- Panel de información -->
        <div class="col-md-6 col-lg-7">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información</h6>
                </div>
                <div class="card-body">
                    <h6>¿Por qué cambiar mi contraseña?</h6>
                    <p class="text-muted">
                        Por políticas de privacidad y seguridad, cada usuario debe mantener su contraseña
                        de forma confidencial. Se recomienda cambiarla cuando:
                    </p>
                    <ul class="text-muted">
                        <li>Sea la primera vez que accede al sistema</li>
                        <li>El administrador le haya asignado una contraseña temporal</li>
                        <li>Sospeche que su contraseña pudo haber sido comprometida</li>
                        <li>Cada 90 días por políticas de seguridad</li>
                    </ul>

                    <hr />

                    <h6>Consejos para una contraseña segura:</h6>
                    <ul class="text-muted">
                        <li>Use una combinación de letras, números y símbolos</li>
                        <li>No use información personal (nombre, fecha de nacimiento)</li>
                        <li>No reutilice contraseñas de otros sistemas</li>
                        <li>No comparta su contraseña con nadie</li>
                    </ul>

                    <hr />

                    <div class="alert alert-warning mb-0">
                        <small>
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            <strong>Importante:</strong> Al cambiar su contraseña, deberá usar la nueva
                            en el próximo inicio de sesión.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CambiarPasswordDto model = new();
    private bool guardando = false;
    private string mensajeExito = "";
    private string mensajeError = "";

    private async Task CambiarPasswordHandler()
    {
        guardando = true;
        mensajeExito = "";
        mensajeError = "";

        try
        {
            (bool success, string message) = await AuthService.CambiarPasswordAsync(model);

            if (success)
            {
                mensajeExito = message;
                model = new CambiarPasswordDto();
            }
            else
            {
                mensajeError = message;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarFormulario()
    {
        model = new CambiarPasswordDto();
        mensajeExito = "";
        mensajeError = "";
    }
}