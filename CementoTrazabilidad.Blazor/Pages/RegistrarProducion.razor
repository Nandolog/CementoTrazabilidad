@page "/turno/{TurnoId:int}/produccion/nueva"
@layout MainLayout
@attribute [Authorize(Roles = "Administrador,Supervisor,JefeTurno,Operario")]
@using CementoTrazabilidad.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject ITurnoService TurnoService
@inject IMaterialService MaterialService
@inject ILoteService LoteService
@inject NavigationManager Navigation
@inject ILogger<RegistrarProducion> Logger
@inject IJSRuntime JS

<PageTitle>Registrar Bolsas Rotas - CementoTrazabilidad</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="fas fa-industry me-2"></i>Registrar Bolsas Rotas</h1>
            <p class="text-muted">Turno @TurnoId - @turnoInfo</p>
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Cargando...</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <EditForm Model="@produccionModel" OnValidSubmit="RegistrarProduccionAsync">
                    <DataAnnotationsValidator />

                    <!-- Mantener LoteID en el formulario para validación -->
                    <InputHidden bind-value="produccionModel.LoteID" />
                    <ValidationMessage For="@(() => produccionModel.LoteID)" />

                    @if (produccionModel.LoteID == null || produccionModel.LoteID == 0)
                    {
                        <div class="alert alert-danger">
                            <strong>Atención:</strong> No hay un lote seleccionado. Abre el lote y luego registra las bolsas rotas.
                        </div>
                    }

                    <!-- ✅ Información del Lote (Solo lectura) -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <label class="text-muted small text-uppercase fw-bold mb-1">Lote</label>
                                <h5 class="mb-0">@produccionModel.NumeroLote</h5>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <label class="text-muted small text-uppercase fw-bold mb-1">Material</label>
                                <h5 class="mb-0">@produccionModel.MaterialNombre</h5>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded">
                                <label class="text-muted small text-uppercase fw-bold mb-1">Bolsas Elaboradas</label>
                                <h5 class="mb-0">@produccionModel.CantidadBolsas.ToString("N0")</h5>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- ✅ Formulario de Registro -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-times-circle text-danger me-2"></i>
                                Bolsas Rotas <span class="text-danger">*</span>
                            </label>
                            <InputNumber class="form-control form-control-lg"
                                         @bind-Value="produccionModel.BolsasRotas"
                                         min="0"
                                         placeholder="Ej: 5" />
                            <ValidationMessage For="@(() => produccionModel.BolsasRotas)" />
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Cantidad de bolsas que resultaron defectuosas
                            </small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-clock text-primary me-2"></i>
                                Horas de Marcha
                            </label>
                            <InputNumber class="form-control form-control-lg"
                                         @bind-Value="produccionModel.HorasMarcha"
                                         step="0.1"
                                         min="0"
                                         max="24"
                                         placeholder="Ej: 8.5" />
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Horas efectivas de producción (0 - 24)
                            </small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fas fa-comment me-2"></i>
                            Observaciones
                        </label>
                        <InputTextArea class="form-control"
                                       @bind-Value="produccionModel.Observaciones"
                                       rows="3"
                                       placeholder="Comentarios adicionales sobre las bolsas rotas..." />
                    </div>

                    <!-- ✅ Resumen -->
                    <div class="alert alert-warning border-2">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                            <div>
                                <strong>Confirmación:</strong> Se registrarán
                                <span class="badge bg-danger text-white fs-6">@produccionModel.BolsasRotas</span>
                                bolsas rotas para el lote
                                <strong>@produccionModel.NumeroLote</strong>
                            </div>
                        </div>
                    </div>

                    <!-- ✅ Botones -->
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-secondary btn-lg" @onclick="Cancelar" disabled="@registrando">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-warning btn-lg" disabled="@((registrando) || (produccionModel.LoteID == null) || (produccionModel.LoteID == 0))">
                            @if (registrando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Registrando...</span>
                            }
                            else
                            {
                                <i class="fas fa-save me-2"></i>
                                <span>Registrar Bolsas Rotas</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int TurnoId { get; set; }
    [Parameter]
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery]
    public int? LoteID { get; set; }

    private ProduccionModel produccionModel = new();
    private bool cargando = false;
    private bool registrando = false;
    private string turnoInfo = "";
    private int turnoProduccionID = 0;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            var turno = await TurnoService.GetTurnoByIdAsync(TurnoId);
            if (turno != null)
            {
                turnoInfo = $"{turno.Fecha:dd/MM/yyyy} - Turno {turno.TurnoNumero}";
                turnoProduccionID = turno.TurnoProduccionID;
            }

            if (LoteID.HasValue)
            {
                var lote = await LoteService.GetLoteByIdAsync(LoteID.Value);
                if (lote != null)
                {
                    // CORRECCIÓN: usar la propiedad que el API devuelve en GetLotePorId
                    produccionModel.LoteID = lote.LoteID;
                    produccionModel.NumeroLote = lote.NumeroLote;
                    produccionModel.CantidadBolsas = lote.CantidadBolsas;
                    produccionModel.MaterialID = lote.MaterialID;
                    produccionModel.MaterialNombre = lote.MaterialNombre;
                    produccionModel.BolsasRotas = lote.BolsasRotas;
                }
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task RegistrarProduccionAsync()
    {
        registrando = true;
        try
        {
            if (produccionModel.LoteID == null || produccionModel.LoteID == 0)
            {
                await JS.InvokeVoidAsync("alert", "No se ha seleccionado un Lote válido. Abre el lote e inténtalo de nuevo.");
                return;
            }

            var dto = new UpdateLoteProduccionDto
            {
                LoteID = produccionModel.LoteID ?? 0,
                BolsasRotas = produccionModel.BolsasRotas,
                HorasMarcha = (decimal)produccionModel.HorasMarcha,
                Observaciones = produccionModel.Observaciones
            };

            var result = await LoteService.ActualizarLoteAsync(dto);

            // Suponiendo que ActualizarLoteAsync devuelve un bool y no una tupla
            bool success = result;
            string message = string.Empty; // O asigna un mensaje adecuado si tienes acceso a uno

            if (success)
            {
                await JS.InvokeVoidAsync("alert", $"Datos guardados correctamente. Bolsas rotas: {produccionModel.BolsasRotas}");
                Navigation.NavigateTo($"/turno/{TurnoId}");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Error al guardar los datos: {message}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al registrar bolsas rotas");
            await JS.InvokeVoidAsync("alert", "Excepción al guardar. Revisa el log del servidor.");
        }
        finally
        {
            registrando = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo($"/turno/{TurnoId}");
    }

    // Modelo para la página
    public class ProduccionModel
    {
        [Required(ErrorMessage = "Debe seleccionar un lote.")]
        public int? LoteID { get; set; }
        public string NumeroLote { get; set; } = string.Empty;
        public int CantidadBolsas { get; set; }
        public int MaterialID { get; set; }
        public string MaterialNombre { get; set; } = string.Empty;
        public int BolsasRotas { get; set; }
        public double HorasMarcha { get; set; }
        public string Observaciones { get; set; } = string.Empty;
    }
}