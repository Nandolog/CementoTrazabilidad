@page "/control-peso"
@layout MainLayout
@attribute [Authorize(Roles = "Administrador,Supervisor,JefeTurno,Operario")]
@using CementoTrazabilidad.Shared.DTOs
@using CementoTrazabilidad.Blazor.Services
@using System.Globalization
@inject IControlPesoService ControlPesoService
@inject ITurnoService TurnoService
@inject NavigationManager Navigation
@inject ILogger<ControlPeso> Logger

<PageTitle>Control de Peso - CementoTrazabilidad</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1><i class="fas fa-weight me-2"></i>Control de Peso</h1>
            <p class="text-muted">Verificación de peso de las 8 boquillas de carga</p>
        </div>
        <div class="col-auto">
            @if (turnoActual != null)
            {
                <span class="badge bg-success fs-6 me-2">
                    <i class="fas fa-play-circle me-1"></i>
                    Turno @turnoActual.TurnoNumero Activo
                </span>
            }
            else
            {
                <span class="badge bg-warning fs-6 me-2">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    No hay turno activo
                </span>
            }
        </div>
    </div>

    @if (turnoActual == null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-info-circle me-2"></i>
            Debe iniciar un turno para registrar controles de peso.
            <button class="btn btn-sm btn-primary ms-3" @onclick="IrAProduccion">
                Ir a Turnos
            </button>
        </div>
    }
    else
    {
        <!-- TABS: REGISTRAR | HISTORIAL -->
        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(tabActiva == "registrar" ? "active" : "")"
                        @onclick='() => CambiarTab("registrar")'>
                    <i class="fas fa-plus-circle me-2"></i>Registrar Control
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tabActiva == "historial" ? "active" : "")"
                        @onclick='() => CambiarTab("historial")'>
                    <i class="fas fa-history me-2"></i>Historial
                    @if (controles.Any())
                    {
                        <span class="badge bg-primary ms-1">@controles.Count</span>
                    }
                </button>
            </li>
        </ul>

        <!-- TAB: REGISTRAR -->
        @if (tabActiva == "registrar")
        {
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Nuevo Control de Peso</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Material</label>
                            <select class="form-select" @bind="materialSeleccionado">
                                <option value="1">CPII C32</option>
                                <option value="2">CPII F40</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Peso Objetivo (kg)</label>
                            <input type="text" class="form-control"
                                   value="@pesoObjetivo.ToString("F2", CulturaLocal)"
                                   @onchange="ActualizarPesoObjetivo"
                                   placeholder="50,00" />
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Peso objetivo por bolsa (50 kg estándar)
                            </small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Operador</label>
                            @if (operadoresTurno.Any())
                            {
                                <select class="form-select" @bind="operadorResponsable">
                                    <option value="">-- Seleccionar operador --</option>
                                    @foreach (var op in operadoresTurno)
                                    {
                                        <option value="@op.PersonalNombre">
                                            @op.PersonalNombre (@op.RolTurno)
                                        </option>
                                    }
                                </select>
                                <small class="text-muted">
                                    <i class="fas fa-users me-1"></i>
                                    @operadoresTurno.Count operador(es) asignado(s) al turno
                                </small>
                            }
                            else
                            {
                                <input type="text" class="form-control" @bind="operadorResponsable"
                                       placeholder="Ingrese el nombre del operador" />
                                <small class="text-warning">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    No hay operadores asignados a este turno
                                </small>
                            }
                        </div>
                    </div>

                    <div class="alert alert-info py-2 mb-3">
                        <small>
                            <i class="fas fa-info-circle me-1"></i>
                            <strong>Importante:</strong> El <strong>Peso Balanza</strong> es el valor de referencia.
                            El <strong>Peso Controlador</strong> es el valor que muestra la máquina y debe ajustarse para que coincida con la balanza.
                        </small>
                    </div>

                    <hr />

                    <h6 class="mb-3"><i class="fas fa-list-ol me-2"></i>Pesos por Boquilla</h6>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-center" style="width: 80px;">Boquilla</th>
                                    <th class="text-center">Peso Balanza (kg) ✅</th>
                                    <th class="text-center">Peso Controlador (kg)</th>
                                    <th class="text-center">Diferencia (Bal. - Ctrl.)</th>
                                    <th class="text-center">Ajuste a Aplicar (kg)</th>
                                    <th class="text-center">Observación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < detalles.Count; i++)
                                {
                                    var idx = i;
                                    var dif = detalles[idx].PesoBalanza - detalles[idx].PesoControlador;
                                    var difClass = Math.Abs(dif) <= 0.1m ? "text-success" :
                                    Math.Abs(dif) <= 0.3m ? "text-warning" : "text-danger";

                                    <tr class="@(GetFilaClass(idx))">
                                        <td class="text-center fw-bold">
                                            <span class="badge bg-secondary">B@(detalles[idx].NumeroBoquilla)</span>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center"
                                                   value="@detalles[idx].PesoBalanza.ToString("F3", CulturaLocal)"
                                                   @onchange="(e) => ActualizarPesoBalanza(idx, e)"
                                                   placeholder="50,000" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center"
                                                   value="@detalles[idx].PesoControlador.ToString("F3", CulturaLocal)"
                                                   @onchange="(e) => ActualizarPesoControlador(idx, e)"
                                                   placeholder="50,000" />
                                        </td>
                                        <td class="text-center">
                                            <span class="@difClass fw-bold">@dif.ToString("+0.000;-0.000;0.000", CulturaLocal)</span>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center"
                                                   value="@detalles[idx].AjusteAplicado.ToString("F3", CulturaLocal)"
                                                   @onchange="(e) => ActualizarAjuste(idx, e)"
                                                   placeholder="0,000" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   value="@detalles[idx].Observacion"
                                                   @onchange="(e) => ActualizarObservacion(idx, e)"
                                                   placeholder="Opcional" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Resumen en tiempo real -->
                    <div class="row mt-3">
                        <div class="col-md-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-2">
                                    <small class="text-muted">Promedio Balanza</small>
                                    <h5 class="mb-0">@CalcularPromedioBalanza().ToString("N3", CulturaLocal) kg</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-2">
                                    <small class="text-muted">Diferencia Promedio</small>
                                    <h5 class="mb-0">@CalcularDiferenciaPromedio().ToString("+0.000;-0.000;0.000", CulturaLocal) kg</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-2">
                                    <small class="text-muted">Desviación Estándar</small>
                                    <h5 class="mb-0">@CalcularDesviacion().ToString("N3", CulturaLocal) kg</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-2">
                                    <small class="text-muted">Fuera de Tolerancia</small>
                                    <h5 class="mb-0 text-danger">@ContarFueraTolerancia() / 8</h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Observaciones generales -->
                    <div class="mt-3">
                        <label class="form-label fw-bold">Observaciones Generales</label>
                        <textarea class="form-control" rows="2" @bind="observacionesGenerales"
                                  placeholder="Observaciones del control..."></textarea>
                    </div>

                    <!-- Botones -->
                    <div class="mt-4 d-flex justify-content-end">
                        <button class="btn btn-secondary me-2" @onclick="LimpiarFormulario">
                            <i class="fas fa-eraser me-2"></i>Limpiar
                        </button>
                        <button class="btn btn-primary" @onclick="RegistrarControl" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="fas fa-save me-2"></i>
                                <span>Registrar Control</span>
                            }
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success mt-3">
                            <i class="fas fa-check-circle me-2"></i>@mensajeExito
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger mt-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>@mensajeError
                        </div>
                    }
                </div>
            </div>
        }

        <!-- TAB: HISTORIAL -->
        @if (tabActiva == "historial")
        {
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Historial de Controles del Turno</h5>
                </div>
                <div class="card-body">
                    @if (controles.Any())
                    {
                        @foreach (var control in controles.OrderByDescending(c => c.NumeroControl))
                        {
                            <div class="card mb-3 @GetEstadoCardClass(control.EstadoControl)">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Control #@control.NumeroControl</strong>
                                        <span class="text-muted ms-3">
                                            <i class="fas fa-clock me-1"></i>@control.FechaHora.ToString("HH:mm:ss")
                                        </span>
                                        <span class="text-muted ms-3">
                                            <i class="fas fa-user me-1"></i>@control.OperadorResponsable
                                        </span>
                                    </div>
                                    <span class="badge @GetEstadoBadge(control.EstadoControl)">
                                        @control.EstadoControl
                                    </span>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-md-3">
                                            <small class="text-muted">Peso Objetivo</small>
                                            <h6>@control.PesoObjetivo.ToString("N3", CulturaLocal) kg</h6>
                                        </div>
                                        <div class="col-md-3">
                                            <small class="text-muted">Promedio Balanza</small>
                                            <h6>@control.PesoPromedioBalanza.ToString("N3", CulturaLocal) kg</h6>
                                        </div>
                                        <div class="col-md-3">
                                            <small class="text-muted">Diferencia Promedio</small>
                                            <h6>@control.DiferenciaPromedio.ToString("+0.000;-0.000;0.000", CulturaLocal) kg</h6>
                                        </div>
                                        <div class="col-md-3">
                                            <small class="text-muted">Desviación</small>
                                            <h6>@control.DesviacionEstandar.ToString("N3", CulturaLocal) kg</h6>
                                        </div>
                                    </div>

                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="text-center">Boquilla</th>
                                                <th class="text-center">Balanza ✅</th>
                                                <th class="text-center">Controlador</th>
                                                <th class="text-center">Diferencia</th>
                                                <th class="text-center">Estado Controlador</th>
                                                <th class="text-center">Estado Peso</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detalle in control.Detalles.OrderBy(d => d.NumeroBoquilla))
                                            {
                                                var difCtrl = detalle.PesoBalanza - detalle.PesoControlador;
                                                var absDifCtrl = Math.Abs(difCtrl);

                                                var difObjetivo = detalle.PesoBalanza - control.PesoObjetivo;
                                                var absDifObjetivo = Math.Abs(difObjetivo);

                                                var (estadoCtrl, iconoCtrl, claseCtrl) = absDifCtrl switch
                                                {
                                                    <= 0.1m => ("Calibrado", "fa-check-circle", "text-success"),
                                                    <= 0.3m => ("Revisar", "fa-exclamation-triangle", "text-warning"),
                                                    _ => ("Descalibrado", "fa-times-circle", "text-danger")
                                                };

                                                var (estadoPeso, iconoPeso, clasePeso) = absDifObjetivo switch
                                                {
                                                    <= 0.5m => ("En norma", "fa-check-circle", "text-success"),
                                                    <= 1.0m => ("Fuera norma", "fa-exclamation-triangle", "text-warning"),
                                                    _ => ("Crítico", "fa-times-circle", "text-danger")
                                                };

                                                <tr class="@(absDifCtrl > 0.3m || absDifObjetivo > 1.0m ? "table-danger" : absDifCtrl > 0.1m || absDifObjetivo > 0.5m ? "table-warning" : "")">
                                                    <td class="text-center fw-bold">B@(detalle.NumeroBoquilla)</td>
                                                    <td class="text-center"><strong>@detalle.PesoBalanza.ToString("N3", CulturaLocal)</strong></td>
                                                    <td class="text-center">@detalle.PesoControlador.ToString("N3", CulturaLocal)</td>
                                                    <td class="text-center">@difCtrl.ToString("+0.000;-0.000;0.000", CulturaLocal)</td>
                                                    <td class="text-center">
                                                        <i class="fas @iconoCtrl @claseCtrl"
                                                           title="@estadoCtrl (Dif: @absDifCtrl.ToString("N3", CulturaLocal) kg)"></i>
                                                        <small class="ms-1 @claseCtrl">@estadoCtrl</small>
                                                    </td>
                                                    <td class="text-center">
                                                        <i class="fas @iconoPeso @clasePeso"
                                                           title="@estadoPeso (Desvío: @difObjetivo.ToString("+0.000;-0.000;0.000", CulturaLocal) kg)"></i>
                                                        <small class="ms-1 @clasePeso">@estadoPeso</small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    @if (!string.IsNullOrEmpty(control.Observacion))
                                    {
                                        <div class="alert alert-info mb-0 py-2">
                                            <small><i class="fas fa-comment me-1"></i>@control.Observacion</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            No hay controles registrados en este turno.
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {

    // ==================== CULTURA LOCAL (coma decimal) ====================
    private static readonly CultureInfo CulturaLocal = CultureInfo.GetCultureInfo("es-PY");

    private string tabActiva = "registrar";
    private TurnoDto? turnoActual;
    private List<ControlPesoDto> controles = new();
    private List<PersonalTurnoDto> operadoresTurno = new();

    private List<ControlPesoDetalleDto> detalles = new();
    private int materialSeleccionado = 1;
    private decimal pesoObjetivo = 50.0m;
    private string operadorResponsable = "";
    private string observacionesGenerales = "";

    private bool guardando = false;
    private string mensajeExito = "";
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        detalles = Enumerable.Range(1, 8)
            .Select(i => new ControlPesoDetalleDto
            {
                NumeroBoquilla = i,
                PesoBalanza = 50.0m,
                PesoControlador = 50.0m,
                AjusteAplicado = 0m,
                Observacion = ""
            })
            .ToList();

        await CargarTurnoActivo();
        if (turnoActual != null)
        {
            await CargarControles();
        }
    }

    private void CambiarTab(string tab)
    {
        tabActiva = tab;
    }

    private void IrAProduccion()
    {
        Navigation.NavigateTo("/produccion");
    }

    private async Task CargarTurnoActivo()
    {
        try
        {
            var turno = await TurnoService.GetTurnoActivoAsync();
            if (turno != null)
            {
                turnoActual = new TurnoDto
                {
                    TurnoProduccionID = turno.TurnoProduccionID,
                    Fecha = turno.Fecha,
                    TurnoNumero = turno.TurnoNumero,
                    Estado = turno.Estado
                };

                try
                {
                    operadoresTurno = await TurnoService.GetPersonalTurnoAsync(turno.TurnoProduccionID);
                    Logger.LogInformation($"✅ Operadores cargados: {operadoresTurno.Count}");

                    if (operadoresTurno.Any() && string.IsNullOrEmpty(operadorResponsable))
                    {
                        operadorResponsable = operadoresTurno.First().PersonalNombre;
                        Logger.LogInformation($"✅ Operador auto-seleccionado: {operadorResponsable}");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error al cargar operadores del turno");
                    operadoresTurno = new List<PersonalTurnoDto>();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar turno activo");
        }
    }

    private async Task CargarControles()
    {
        if (turnoActual == null) return;

        controles = await ControlPesoService.GetControlesPorTurno(turnoActual.TurnoProduccionID);
    }

    private async Task RegistrarControl()
    {
        if (turnoActual == null)
        {
            mensajeError = "No hay turno activo";
            return;
        }

        guardando = true;
        mensajeError = "";
        mensajeExito = "";

        try
        {
            var dto = new CrearControlPesoDto
            {
                TurnoProduccionID = turnoActual.TurnoProduccionID,
                MaterialID = materialSeleccionado,
                OperadorResponsable = string.IsNullOrEmpty(operadorResponsable) ? "Operario" : operadorResponsable,
                Observacion = observacionesGenerales,
                Detalles = detalles
            };

            var resultado = await ControlPesoService.RegistrarControlPeso(dto);

            if (resultado != null)
            {
                mensajeExito = $"✅ Control #{resultado.NumeroControl} registrado exitosamente. Estado: {resultado.EstadoControl}";
                LimpiarFormulario();
                await CargarControles();
            }
            else
            {
                mensajeError = "Error al registrar el control. Verifique los datos e intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al registrar control de peso");
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarFormulario()
    {
        detalles = Enumerable.Range(1, 8)
            .Select(i => new ControlPesoDetalleDto
            {
                NumeroBoquilla = i,
                PesoBalanza = 50.0m,
                PesoControlador = 50.0m,
                AjusteAplicado = 0m,
                Observacion = ""
            })
            .ToList();
        observacionesGenerales = "";
    }

    // ==================== ACTUALIZADORES CON VALIDACIÓN Y CULTURA LOCAL ====================

    private void ActualizarPesoObjetivo(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CulturaLocal, out var valor))
        {
            if (valor >= 1 && valor <= 100)
            {
                pesoObjetivo = valor;
            }
        }
    }

    private void ActualizarPesoBalanza(int idx, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CulturaLocal, out var valor))
        {
            if (valor >= 0 && valor <= 100)
            {
                detalles[idx].PesoBalanza = valor;
            }
        }
    }

    private void ActualizarPesoControlador(int idx, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CulturaLocal, out var valor))
        {
            if (valor >= 0 && valor <= 100)
            {
                detalles[idx].PesoControlador = valor;
            }
        }
    }

    private void ActualizarAjuste(int idx, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CulturaLocal, out var valor))
        {
            if (valor >= -5 && valor <= 5)
            {
                detalles[idx].AjusteAplicado = valor;
            }
        }
    }

    private void ActualizarObservacion(int idx, ChangeEventArgs e)
    {
        detalles[idx].Observacion = e.Value?.ToString() ?? "";
    }

    // ==================== CÁLCULOS ====================

    private decimal CalcularPromedioBalanza()
    {
        if (!detalles.Any()) return 0;
        return Math.Round(detalles.Average(d => d.PesoBalanza), 3);
    }

    private decimal CalcularDiferenciaPromedio()
    {
        if (!detalles.Any()) return 0;
        return Math.Round(detalles.Average(d => d.PesoBalanza - d.PesoControlador), 3);
    }

    private decimal CalcularDesviacion()
    {
        var valores = detalles.Select(d => d.PesoBalanza).ToList();
        if (valores.Count <= 1) return 0;

        var promedio = valores.Average();
        var sumaCuadrados = valores.Sum(v => (v - promedio) * (v - promedio));
        return Math.Round((decimal)Math.Sqrt((double)(sumaCuadrados / (valores.Count - 1))), 3);
    }

    private int ContarFueraTolerancia()
    {
        var min = pesoObjetivo - 0.5m;
        var max = pesoObjetivo + 0.5m;
        return detalles.Count(d => d.PesoBalanza < min || d.PesoBalanza > max);
    }

    private string GetFilaClass(int index)
    {
        if (index >= detalles.Count) return "";
        var detalle = detalles[index];
        var dif = Math.Abs(detalle.PesoBalanza - detalle.PesoControlador);

        if (dif > 0.3m) return "table-danger";
        if (dif > 0.1m) return "table-warning";
        return "";
    }

    private string GetEstadoCardClass(string estado)
    {
        return estado switch
        {
            "OK" => "border-success",
            "FUERA_TOLERANCIA" => "border-warning",
            "CRITICO" => "border-danger",
            _ => ""
        };
    }

    private string GetEstadoBadge(string estado)
    {
        return estado switch
        {
            "OK" => "bg-success",
